
project_name   : "terra";
version        : "1.0.0";
out_dir        : "../out";
build_dir      : "bld";
sdk_dir        : "sdk";
runtime_dir    : "rt";
download_dir   : "dl";
frameworks_dir : "Frameworks";
manifests_dir  : "media/Plugins";
plugin_dir     : "media/Plugins/bin"; // plugins will be placed in Plugins/bin, manifests will be placed in 
verbose        : true;

preset win-dbg
{
  display_name         : "win-dbg";
  build_type           : debug;
  allow                : [debug, windows];
  disallow             : [release];
  static_libs          : true;
  cppcheck             : false;
  unity_build          : false; // Intellisense does not work with this as true
  naming               : "terra_$(module_name)";

  config [msvc]
  {
    compiler_flags  : [ "/std:c++20", "/Zc:__cplusplus", "/Zc:preprocessor", "/source-charset:utf-8", "/bigobj", "/fsanitize=address" , "/Zi" ];
    linker_flags    : [ "/debug", "-incremental:no" ];
  }
  config [gcc]
  {
    compiler_flags  : [
      "-std=c++2a"
    ];
    linker_flags    : [
      "-Wl,--no-undefined"
    ];
  }
}

preset win-rel
{
  display_name         : "win-rel";
  build_type           : release;
  allow                : [release, windows];
  disallow             : [debug];
  static_libs          : true;
  cppcheck             : false;
  unity_build          : false; // Intellisense does not work with this as true
  naming               : "terra_$(module_name)";

  config [msvc]
  {
    compiler_flags  : [ "/std:c++20", "/Zc:__cplusplus", "/Zc:preprocessor", "/source-charset:utf-8", "/bigobj" ];
    linker_flags    : [ "-incremental:no" ];
  }
  config [gcc]
  {
    compiler_flags  : [
      "-std=c++2a"
    ];
    linker_flags    : [
      "-Wl,--no-undefined"
    ];
  }
}

