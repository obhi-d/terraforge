type = extern;

fetch "https://github.com/fmtlib/fmt.git"
{
  license    : "LICENSE.rst";
  commit     : "a33701196adfad74917046096bf5a2aa0ab0bb50";
  package    : fmt;
  args
  {
    FMT_DOC                          : OFF;
    FMT_TEST                         : OFF;
    FMT_FUZZ                         : OFF;
    FMT_CUDA_TEST                    : OFF;
    FMT_INSTALL                      : ON;
    FMT_OS                           : ON;
    CMAKE_POSITION_INDEPENDENT_CODE  : ON;
  }
}
