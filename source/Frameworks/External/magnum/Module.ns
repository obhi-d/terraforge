type = extern;

version : "1.0.0";

fetch "https://github.com/mosra/magnum.git"
{
  license    : "LICENSE";
  commit     : "fa00122fdb84eab23064d83c36d50757fdf899c1";
  package    : Magnum;
  namespace  : Magnum;
  components : [GL, Trade, Shaders];
  fetch_content: true;
  args
  {
    MAGNUM_BUILD_STATIC : ON;
    MAGNUM_BUILD_PLUGINS_STATIC : ON;
    MAGNUM_WITH_SDL2APPLICATION : OFF;
    MAGNUM_WITH_WINDOWLESSWGLAPPLICATION : ON;
    MAGNUM_WITH_GLFWAPPLICATION : OFF;
    MAGNUM_WITH_MESHTOOLS  : OFF;
    MAGNUM_WITH_TRADE : ON;
    MAGNUM_WITH_TEXT : OFF;
    MAGNUM_WITH_TEXTURETOOLS :OFF ; 
  }
}

public:
{
  dependencies: [ "External.corrade", "External.sdl2" ];
}

{{cmake:prepare}}
find_package(Corrade REQUIRED Main PATHS ${fetch_sdk_dir} NO_DEFAULT_PATH)
