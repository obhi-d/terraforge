type = extern;

version : "2.24.0";

fetch "https://github.com/libsdl-org/SDL.git"
{
  license    : "LICENSE";
  commit     : "33050fea3997c7d0c1cf709fa5a70f5462e35ad9";
  package    : SDL2;
  components : [SDL2main, SDL2-static];
  namespace  : SDL2;
  args
  {
    SDL_ATOMIC     : OFF;
    SDL_CPUINFO    : OFF;
    SDL_FILE       : OFF;
    SDL_FILESYSTEM : OFF;
    SDL_HAPTIC     : OFF;
    SDL_LOCALE     : OFF;
    SDL_POWER      : OFF;
    SDL_RENDER     : OFF;
    SDL_SENSOR     : OFF;
    SDL_THREADS    : ON;
    SDL_STATIC     : ON;
    SDL_SHARED     : OFF;
  }
}
