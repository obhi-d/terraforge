type = extern;

fetch "https://github.com/microsoft/mimalloc.git"
{
  license    : "LICENSE";
  commit     : "f2712f4a8f038a7fb4df2790f4c3b7e3ed9e219b";
  package    : mimalloc;
  targets    : mimalloc;
  skip_namespace : true;
  args
  {
    MI_BUILD_TESTS  : OFF;
    MI_BUILD_SHARED : ON;
    MI_BUILD_STATIC : OFF;
  }
}
