name     = "@ToRGBA";
category = "@Modifiers";
brief    = "@ToRGBABrief";
help     = "@ToRGBAHelp";
function = "to_RGBA";
type     = image (format = unorm8);

shaders
{
  config default_config
  {
    files = ["to_RGBA.comp"];
  };
};

param Source(type = source, min = -1.0f, max = 1.0f, default = 1.0, tooltip=@InputSource);
param MinMax(type = source, tooltip=@MinMaxSource, subtype = vec2);
