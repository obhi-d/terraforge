name        = "@GetMinMax";
category    = "@Utility";
tooltip       = "@GetMinMaxBrief";
help        = "@GetMinMaxHelp";
function    = "get_min_max";
output      = vec2 (downscale = 16);
iteration   = inf;

shaders
{
  config default_config
  {
    files = ["get_min_max.comp"];
  };
};

param Source(type = source, min = -1.0f, max = 1.0f, default = 1.0, step = 0.1f);
