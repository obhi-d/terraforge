name     = "@ToRGBA";
category = "@Modifiers";
tooltip    = "@ToRGBABrief";
help     = "@ToRGBAHelp";
function = "to_RGBA";
output   = image (format = unorm8);
icon     = "\xef\x87\x85";

shaders
{
  config default_config
  {
    files = ["to_RGBA.comp"];
  };
};

param Source(name = "@Source", type = source, min = -1.0f, max = 1.0f, default = 1.0, step = 0.1f, tooltip=@InputSource);
param MinMax(name = "@MinMax", type = source, min = -1.0f, max = 1.0f, default = 1.0, step = 0.1f, tooltip=@MinMaxSource, subtype = vec2);
