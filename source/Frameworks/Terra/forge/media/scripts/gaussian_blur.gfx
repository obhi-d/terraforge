name  : GaussianBlur;
style : operators;

output : heights (type = [source, float], semantic = heights, decltype = sampler2D);
param  : source (type = [source, float], semantic = heights, decltype = sampler2D, min = -inf, max = inf, default = 0.0, step = 0.001, sampler = linearclamp);
param  : blur_window (type = int, decltype = scalar, min = 0, max = 6, default = 1, step = 1, semantic = blur_window);
param  : blur_stddev (type = float, decltype = scalar, min = 0, max = 10, default = 1, step = 0.01, semantic = blur_stddev);
param  : gauss_blur_factor (type = [buffer, float], decltype = readonlyStorageBuffer, semantic = gauss_blur_factor) hidden;
param  : rsize (type = float2, decltype = scalar, semantic = rsize) hidden;

pass GaussianBlur
{
  function : blur;
  shaders  : [gaussian_blur.glsl];
  in       : [source, gauss_blur_factor, rsize];
  out      : heights;
}
