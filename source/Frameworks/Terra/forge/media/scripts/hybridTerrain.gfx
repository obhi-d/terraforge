
name   : HybridTerrain;
style  : noise;

output : heights (type = [buffer, float], semantic = heights, decltype = sampler2D);
param  : octaves (type = uint, decltype = scalar, semantic = octaves, min = 1, max = 16, default = 8, step = 1);
param  : fseed (type = [float, float], semantic = fseed, decltype = scalar) hidden;
param  : frequency (type = float, semantic = frequency, decltype = scalar, min = -inf, max = inf, default = 0.6573, step = 0.001);
param  : amplitude (type = float, decltype = scalar, min = -inf, max = inf, default = 13.37, step = 0.01);
param  : exponent (type = float, semantic = exponent, decltype = scalar, min = 0.0, max = 10000.0, default = 1.52, step = 0.01);
param  : exponents (type = [array, float], decltype = scalar, semantic = expoctave) hidden;
param  : lacunarity (type = float, decltype = scalar, semantic = lacunarity, min = 0.0, max = 10000.0, default = 4.46, step = 0.01);
param  : offset (type = float, decltype = scalar, min = -inf, max = inf, default = 0.57, step = 0.01);
param  : gain (type = float, decltype = scalar, min = -inf, max = inf, default = 5.24, step = 0.01);
param  : start (type = float2, semantic = start, decltype = scalar) hidden;
param  : size (type = float2, semantic = size, decltype = scalar) hidden;

pass
{
  function : noise;
  shaders  : [opensimplex2s.glsl, hybrid_mfractal.glsl];
  in       : [fseed, frequency, octaves, lacunarity, amplitude, exponents, gain, offset, start, size];
  out      : heights;
}

