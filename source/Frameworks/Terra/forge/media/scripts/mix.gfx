name  : Mix;
style : operators;


output : heights (type = [source, float], semantic = heights, decltype = sampler2D);
param  : source_a (type = [source, float], semantic = heights, decltype = sampler2D, min = -inf, max = inf, default = 0.0, step = 0.001, sampler = none, preeval = true);
param  : source_b (type = [source, float], semantic = heights, decltype = sampler2D, min = -inf, max = inf, default = 0.0, step = 0.001, sampler = none, preeval = true);
param  : source_factor (type = [source, float], semantic = heights, decltype = sampler2D, min = -inf, max = inf, default = 0.0, step = 0.001, sampler = none, preeval = true);

pass Mix
{
  function : mixer;
  shaders  : [mix.glsl];
  in       : [source_a, source_b, source_factor];
  out      : heights;
}
